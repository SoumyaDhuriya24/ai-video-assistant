# ── LLM Provider: "ollama" (Local, no key needed) or "meta" (Cloud API) ─────────
LLM_PROVIDER=ollama

# ── Local Ollama Configuration ─────────────────────────────────────────────────
OLLAMA_MODEL=mistral:7b
OLLAMA_BASE_URL=http://localhost:11434

# ── Meta AI API Configuration ──────────────────────────────────────────────────
# Your Meta Model API Key (from Meta Developer portal, starting with LLM_...)
META_AI_API_KEY=LLM_your_api_key_here
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1

# ── Sarvam AI (Optional: for Hinglish STT / Translation) ───────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here
